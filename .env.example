# PLANNED configuration contract only; application/Compose are not implemented.
# Copy to .env for future local development; never commit real credentials.
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL | SQLite (switching does not migrate data)
Database__Provider=SQLite
Database__ConnectionString=Data Source=/data/db/maildev.db
# PostgreSQL example: Host=postgres;Database=maildev;Username=maildev;Password=<set-locally>

# Volume | S3 | AzureBlob
Storage__Provider=Volume
Storage__Volume__RootPath=/data/files
# S3 settings are required only when S3 is selected; use the SDK credential chain.
# Storage__S3__Bucket=your-private-bucket
# Storage__S3__Region=your-region
# Storage__S3__ServiceUrl=https://your-compatible-endpoint
# AWS_ACCESS_KEY_ID=<set-locally-if-required>
# AWS_SECRET_ACCESS_KEY=<set-locally-if-required>
# AWS_SESSION_TOKEN=<set-locally-for-temporary-credentials>
# AzureBlob uses managed identity/standard credential chain; never commit credentials.
# Storage__AzureBlob__Container=your-private-container
# Storage__AzureBlob__ServiceUri=https://your-account.blob.core.windows.net

# InMemory | Redis
Cache__Provider=InMemory
# Illustrative local value only; runtime defaults/bounds must be decided in Tasks.
Cache__DefaultTtlSeconds=300
# Cache__Redis__ConnectionString=<set-locally-when-redis-selected>

# Local development example only; both Scalar and OpenAPI default off in Production.
ApiDocumentation__Enabled=true
